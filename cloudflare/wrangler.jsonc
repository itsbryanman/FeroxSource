{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ferox-source-bridge",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // namespace gets created on the first repo
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "ferox" }],
  "durable_objects": { "bindings": [{ "name": "FEROX_REGISTRY", "class_name": "Registry" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registry"] }],
  "assets": { "directory": "../web", "binding": "ASSETS", "run_worker_first": true }
}
